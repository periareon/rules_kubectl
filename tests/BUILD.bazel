load("@rules_go//go:def.bzl", "go_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//kubectl:defs.bzl", "kubectl_binary")

# buildifier: disable=bzl-visibility
load("//kubectl/private:versions.bzl", "DEFAULT_VERSION")

# Must match the `kubectl_dev.toolchain(name = "kubectl_pinned", ...)` tag in MODULE.bazel.
PINNED_VERSION = "1.36.5"

# The host repository created by the default `kubectl.toolchain()` tag.
sh_test(
    name = "host_version_test",
    size = "small",
    srcs = ["version_test.sh"],
    data = ["@kubectl"],
    env = {
        "EXPECTED_VERSION": "v" + DEFAULT_VERSION,
        "KUBECTL": "$(rlocationpath @kubectl//:kubectl)",
    },
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# The `bazel run` launcher in front of the host binary.
sh_test(
    name = "launcher_test",
    size = "small",
    srcs = ["launcher_test.sh"],
    data = ["@kubectl"],
    env = {
        "KUBECTL": "$(rlocationpath @kubectl//:kubectl)",
    },
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Toolchain resolution and the `KUBECTL` make variable.
genrule(
    name = "genrule_version",
    outs = ["genrule_version.json"],
    cmd = "$(KUBECTL) version --client --output json > $@",
    toolchains = ["//kubectl:current_toolchain"],
)

sh_test(
    name = "genrule_version_test",
    size = "small",
    srcs = ["version_test.sh"],
    data = [":genrule_version"],
    env = {
        "EXPECTED_VERSION": "v" + DEFAULT_VERSION,
        "VERSION_JSON": "$(rlocationpath :genrule_version)",
    },
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# The `KUBECTL_RLOCATIONPATH` make variable, resolved through runfiles.
sh_test(
    name = "rlocationpath_version_test",
    size = "small",
    srcs = ["version_test.sh"],
    data = ["//kubectl:current_toolchain"],
    env = {
        "EXPECTED_VERSION": "v" + DEFAULT_VERSION,
        "KUBECTL": "$(KUBECTL_RLOCATIONPATH)",
    },
    toolchains = ["//kubectl:current_toolchain"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# A version without checksums in `kubectl/private/versions.bzl`, resolved by the
# extension at fetch time (and persisted as lockfile facts on Bazel 8.5+).
sh_test(
    name = "pinned_version_test",
    size = "small",
    srcs = ["version_test.sh"],
    data = ["@kubectl_pinned//:kubectl"],
    env = {
        "EXPECTED_VERSION": "v" + PINNED_VERSION,
        "KUBECTL": "$(rlocationpath @kubectl_pinned//:kubectl)",
    },
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# `kubectl_binary` with a generated file in its arguments.
genrule(
    name = "configmap_data",
    outs = ["configmap_data.txt"],
    cmd = "echo 'generated by bazel' > $@",
)

kubectl_binary(
    name = "configmap_dry_run",
    args = [
        "create",
        "configmap",
        "binary-test",
        "--from-file=data.txt=$(rlocationpath :configmap_data)",
        "--dry-run=client",
        "--output=yaml",
    ],
    data = [":configmap_data"],
)

# `kubectl_binary` with a file in its environment.
kubectl_binary(
    name = "config_view",
    args = [
        "config",
        "view",
        "--minify",
        "--output=jsonpath={.clusters[0].cluster.server}",
    ],
    data = ["kubeconfig.yaml"],
    env = {"KUBECONFIG": "$(rlocationpath kubeconfig.yaml)"},
)

# `kubectl_binary` with a generated manifest but no verb, which the caller
# supplies on the command line.
genrule(
    name = "manifest",
    outs = ["manifest.yaml"],
    cmd = "printf 'apiVersion: v1\\nkind: ConfigMap\\nmetadata:\\n  name: manifest-test\\n' > $@",
)

kubectl_binary(
    name = "manifest_kubectl",
    args = ["--filename=$(rlocationpath :manifest)"],
    data = [":manifest"],
)

go_test(
    name = "binary_test",
    size = "small",
    srcs = ["binary_test.go"],
    data = [
        ":config_view",
        ":configmap_dry_run",
        ":manifest_kubectl",
    ],
    env = {
        "CONFIGMAP_DRY_RUN": "$(rlocationpath :configmap_dry_run)",
        "CONFIG_VIEW": "$(rlocationpath :config_view)",
        "MANIFEST_KUBECTL": "$(rlocationpath :manifest_kubectl)",
    },
    deps = ["@rules_go//go/runfiles"],
)
