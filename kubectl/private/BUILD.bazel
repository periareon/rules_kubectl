load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//kubectl:__subpackages__"])

bzl_library(
    name = "bzl_lib",
    srcs = glob(["*.bzl"]),
    visibility = ["//visibility:public"],
    deps = [
        "@bazel_tools//tools:bzl_srcs",
        "@rules_go//go:def",
    ],
)
