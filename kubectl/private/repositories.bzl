"""kubectl repository rules"""

def host_platform(repository_ctx):
    """Return the `{os}-{arch}` platform name of the host, as used in `PLATFORMS`.

    Args:
        repository_ctx (repository_ctx): The repository context.

    Returns:
        str: e.g. `linux-amd64`.
    """
    os_name = repository_ctx.os.name.lower()
    if os_name.startswith("linux"):
        os = "linux"
    elif os_name.startswith("mac os"):
        os = "darwin"
    elif os_name.find("windows") != -1:
        os = "windows"
    else:
        fail("Unrecognized host os: {}".format(repository_ctx.os.name))

    arch = repository_ctx.os.arch
    if arch in ("aarch64", "arm64"):
        arch = "arm64"
    elif arch in ("x86_64", "amd64"):
        arch = "amd64"
    elif arch in ("x86", "i386", "i686"):
        arch = "386"

    return "{}-{}".format(os, arch)

def _repo_metadata(repository_ctx):
    # Bazel <8.3.0 lacks repository_ctx.repo_metadata
    if not hasattr(repository_ctx, "repo_metadata"):
        return None
    return repository_ctx.repo_metadata(reproducible = True)

_TOOLCHAINS_BUILD_HEADER = """\
# @generated by rules_kubectl
load("@rules_kubectl//kubectl:defs.bzl", "kubectl_toolchain")

package(default_visibility = ["//visibility:public"])
"""

_TOOLCHAIN_TEMPLATE = """\
kubectl_toolchain(
    name = "{name}_toolchain",
    kubectl = "{kubectl}",
    version = "{version}",
)

toolchain(
    name = "{name}",
    exec_compatible_with = {exec_compatible_with},
    toolchain = ":{name}_toolchain",
    toolchain_type = "@rules_kubectl//kubectl:toolchain_type",
)
"""

def _kubectl_toolchains_repository_impl(repository_ctx):
    content = [_TOOLCHAINS_BUILD_HEADER]
    for name, kubectl in repository_ctx.attr.binaries.items():
        content.append(_TOOLCHAIN_TEMPLATE.format(
            name = name,
            kubectl = kubectl,
            exec_compatible_with = json.encode(repository_ctx.attr.exec_compatible_with.get(name, [])),
            version = repository_ctx.attr.version,
        ))

    repository_ctx.file("BUILD.bazel", "\n".join(content))

    return _repo_metadata(repository_ctx)

kubectl_toolchains_repository = repository_rule(
    implementation = _kubectl_toolchains_repository_impl,
    doc = """\
Generates the toolchain hub: a `kubectl_toolchain` and a `toolchain` per \
platform, so they can all be registered with `:all`.
""",
    attrs = {
        "binaries": attr.string_dict(
            doc = "The label of the kubectl binary for each toolchain name.",
            mandatory = True,
        ),
        "exec_compatible_with": attr.string_list_dict(
            doc = "Execution platform constraints, keyed by toolchain name.",
            mandatory = True,
        ),
        "version": attr.string(
            doc = "The kubectl version the binaries were built from, without a leading `v`.",
            mandatory = True,
        ),
    },
)

_HOST_BUILD_CONTENT = """\
# @generated by rules_kubectl
load("@rules_kubectl//kubectl:defs.bzl", "kubectl_toolchain")
load("@rules_kubectl//kubectl/private:launcher.bzl", "kubectl_launcher")

package(default_visibility = ["//visibility:public"])

# The host platform's kubectl {version}.
kubectl_toolchain(
    name = "toolchain",
    kubectl = "@{binary_repo}//file",
    version = "{version}",
)

# Runs kubectl from the directory `bazel run` was invoked in.
kubectl_launcher(
    name = "kubectl",
    toolchain = ":toolchain",
)
"""

def _kubectl_host_repository_impl(repository_ctx):
    platform = host_platform(repository_ctx)

    repository_ctx.file("BUILD.bazel", _HOST_BUILD_CONTENT.format(
        binary_repo = repository_ctx.attr.binary_repo_prefix + platform.replace("-", "_"),
        version = repository_ctx.attr.version,
    ))

    return _repo_metadata(repository_ctx)

kubectl_host_repository = repository_rule(
    implementation = _kubectl_host_repository_impl,
    doc = """\
Creates a repository with a short name (`@kubectl` by default) exposing the host \
platform's kubectl as `//:kubectl`, behind a launcher suited to `bazel run`.
""",
    attrs = {
        "binary_repo_prefix": attr.string(
            doc = "Prefix of the per-platform binary repositories. The host repo name is `{prefix}{os}_{arch}`.",
            mandatory = True,
        ),
        "version": attr.string(
            doc = "The version of kubectl the repository points at.",
            mandatory = True,
        ),
    },
)
